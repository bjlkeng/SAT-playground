# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Smoke test logs and generated benchmark/profile artifacts
log/*
!log/bench-10-bve-preprocess-2026-05-18-16-04-01/
log/bench-10-bve-preprocess-2026-05-18-16-04-01/*
!log/bench-10-bve-preprocess-2026-05-18-16-04-01/results.csv
!log/bench-10-bve-preprocess-2026-05-18-16-04-01/summary.log
!log/bench-11-medium-2026-06-21-15-08-05/
log/bench-11-medium-2026-06-21-15-08-05/*
!log/bench-11-medium-2026-06-21-15-08-05/results.csv
!log/bench-11-medium-2026-06-21-15-08-05/summary.log
!log/profiles/
log/profiles/*
!log/profiles/README.md

# Proof checkers (built locally via tools/setup_checkers.sh)
tools/checkers/

# Benchmark instances (downloaded via tools/bench.sh or manually)
benchmarks/sat-comp-2025/*
!benchmarks/sat-comp-2025/MANIFEST.txt
benchmarks/sat-comp-2025-medium/*
!benchmarks/sat-comp-2025-medium/MANIFEST.txt
benchmarks/reference-solvers/*
!benchmarks/reference-solvers/.gitkeep

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# bv (beads viewer) local config and caches
.bv/

# Claude local scheduler locks
.claude/*.lock

# Python bytecode caches
__pycache__/
*.pyc
benchmarks/sat-comp-2026/*
!benchmarks/sat-comp-2026/MANIFEST.txt

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
# prior-year main tracks (bead SAT-playground-d96.11): files not committed, MANIFEST and URI lists are
benchmarks/sat-comp-2020/*
!benchmarks/sat-comp-2020/MANIFEST.txt
benchmarks/sat-comp-2021/*
!benchmarks/sat-comp-2021/MANIFEST.txt
benchmarks/sat-comp-2022/*
!benchmarks/sat-comp-2022/MANIFEST.txt
benchmarks/sat-comp-2023/*
!benchmarks/sat-comp-2023/MANIFEST.txt
benchmarks/sat-comp-2024/*
!benchmarks/sat-comp-2024/MANIFEST.txt
# GBD metadata database (30 MB, downloaded by tools/fetch_prior_tracks.py)
benchmarks/gbd/
